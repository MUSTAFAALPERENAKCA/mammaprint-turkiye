# Veritabanı — docker-compose.yml'de db servisi host portu 6530'a eşlenir (bkz.
# proje port kuralı: tüm servisler 6530-6545 aralığında, hiçbiri çakışmaz)
DATABASE_URL="postgresql://mammaprint:mammaprint@localhost:6530/mammaprint?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:6531"

# Site — docker-compose.yml'de app servisi host portu 6531'e eşlenir
NEXT_PUBLIC_SITE_URL="http://localhost:6531"

# Nesne depolama (S3 uyumlu) — sağlayıcı kararı beklemede, bkz. docs/architecture-decision-record.md ADR-006
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Analytics — GA4 kullanımı KVKK hukuk onayı bekliyor, bkz. ADR-008. Onay öncesi boş bırakılmalı.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Form güvenliği
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="5"
